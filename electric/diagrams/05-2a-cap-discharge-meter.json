{
  "title": "實驗 5-2：用三用電表看電容電壓慢慢掉（放電）",
  "boards": [],
  "parts": [
    {"type": "battery9v", "id": "bat"},
    {"type": "meter", "id": "meter", "mode": "V", "display": "9.00"},
