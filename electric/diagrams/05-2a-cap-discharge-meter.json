    {"type": "capacitor", "value": "100µF", "polar": true, "pins": ["g8", "g11"]},
    {"type": "resistor", "value": "10kΩ", "pins": ["i8", "i11"]}
  ],
  "wires": [
    ["bat:+", "T+3", "red"],
